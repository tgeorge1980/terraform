provider "aws" {
    region = "us-east-1"   
}

resource "aws_vpc" "gxo-vpc" {
    cidr_block = "192.168.0.0/16"
}

resource "aws_subnet" "gxo-subnet" {
    vpc_id            = aws_vpc.gxo-vpc.id
    cidr_block        = "192.168.1.0/24"
    availability_zone = "us-east-1a"
}

resource "aws_security_group" "gxo-sg" {
    name        = "gxo-security-group"
    description = "Security group for GXO resources"
    vpc_id      = aws_vpc.gxo-vpc.id

    ingress {
        from_port   = 22
        to_port     = 22
        protocol    = "tcp"
        cidr_blocks = ["192.168.1.0/16"]
    }

    egress {
        from_port   = 0
        to_port     = 0
        protocol    = "-1"
        cidr_blocks = ["192.168.1.0/16"]
    }

    